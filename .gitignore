# Credentials: never include these in source control or release archives.
streamlit Secrets.txt
.streamlit/secrets.toml
*secrets*.toml
.env
.env.*

# Live data, encrypted backups, and local safety/recovery state.
*.db
*.db-*
*.sqlite
*.sqlite3
# order_data.json is the ENCRYPTED backup the app writes through the GitHub API.
# It is intentionally tracked in the repository even though it is listed here:
# .gitignore only affects untracked files. Never commit a plaintext export or
# lunch.db. Do not delete the tracked file when switching the backup branch.
order_data.json
*.safety.json
*.safety.json.*
*.safety.lock

__pycache__/
*.pyc
.pytest_cache/
.venv/
.test-tmp/
